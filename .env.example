# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose. Used for screenshot uploads during metadata fetch.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Screenshots default to the free Microlink API. Override with a template; {url} is replaced.
# Example: https://pro.microlink.io/?url={url}&screenshot=true&meta=false&apiKey=YOUR_KEY
SCREENSHOT_SERVICE_URL=
# Playwright e2e admin credentials (a user that exists in public.admins)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
